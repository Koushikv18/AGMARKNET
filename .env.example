# ── data.gov.in ────────────────────────────────────────────────────────────────
# Get your free API key at https://data.gov.in/user/register
# The demo key below works but rate-limits to ~100 req/hr.
# A registered key gives ~1000 req/hr — required for full 2013-2025 pull.
API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# ── Spark ──────────────────────────────────────────────────────────────────────
# For local mode (no cluster needed) — uses all CPU cores:
SPARK_MASTER=local[*]
# For YARN cluster (set executor count via spark-submit args):
# SPARK_MASTER=yarn

# ── HDFS (optional) ────────────────────────────────────────────────────────────
# Set USE_HDFS=true to read/write from HDFS instead of local filesystem.
# Leave false for laptop/single-machine runs.
USE_HDFS=false
HDFS_NAMENODE=hdfs://localhost:9000

# ── Local paths (used when USE_HDFS=false) ─────────────────────────────────────
DATA_DIR=data
RESULTS_DIR=results
OUTPUT_DIR=output
